# ─── BACKEND ENVIRONMENT VARIABLES ───
# Managed PostgreSQL database URL (get this from Neon.tech or Supabase)
# Paste your own connection string here. Never commit a real one: this
# file is checked in, so any value written here is visible to everyone
# with repository access.
DATABASE_URL=postgresql://user:password@host:5432/secureflow?sslmode=require

# Secret key for signing JWT tokens (generate using: openssl rand -hex 32)
# Paste the output of that command here. Never commit a real key.
SECRET_KEY=paste-your-own-64-hex-character-secret-here

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Production settings
DEBUG=False
LOG_LEVEL=INFO

# Allowed CORS origins for the frontend app (JSON array)
CORS_ORIGINS=["https://your-app.vercel.app"]

# ─── THIRD-PARTY INTEGRATION APIS ───
# Hugging Face API token for downloading AI models (from huggingface.co)
HF_TOKEN=hf_your_hugging_face_token_here

# AWS configuration (from AWS Console IAM section)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# Key that seals real AWS connector credentials (AES-256-GCM). Required
# before a real (non-demo) cloud account can be registered; demo accounts
# work without it. Generate one with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# and paste the output here. The API and the Celery workers must share the
# same value. Losing or changing it makes previously stored connector
# credentials unreadable, so keep a backup somewhere safe — never in git.
CLOUD_CREDENTIALS_KEY=paste-your-own-base64-32-byte-key-here

# Alerts & Notifications webhooks and keys
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
PAGERDUTY_API_KEY=pd_your_key_here

# ─── FRONTEND ENVIRONMENT VARIABLES ───
# Public URL of the FastAPI backend app (used by React/Vite)
VITE_API_URL=https://your-backend-app.onrender.com/api/v1
